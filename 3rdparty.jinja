{%- set zlib_static_release = 'zlibstatic.lib' %}
{%- set zlib_static_debug = 'zlibstaticd.lib' %}
{%- set rocksdbver = 'v7.10.2' %}
{%- set zlibver = 'v1.3.1' %}

zlib:
  url: https://github.com/madler/zlib.git
  url2: https://github.com/madler/zlib/archive/refs/tags/{{zlibver}}.tar.gz
  url3: https://github.com/madler/zlib/releases/latest
  commit: {{zlibver}}
  shallow: true
  src: 3rdparty/zlib # relative to sortmerna root dir
  build: build/3rdparty/zlib  # cmake build dir
  dist: {{zlib_dist}} # '--zlib-dist' or default 'build/3rdparty/zlib/dist' (setup.py)
  is_git: true
  is_checkout: true  # indicate to perform git checkout

rocksdb:
  url: https://github.com/facebook/rocksdb.git
  url2: https://github.com/facebook/rocksdb/archive/refs/tags/{{rocksdbver}}.tar.gz
  commit: {{rocksdbver}}
  shallow: true
  src: 3rdparty/rocksdb  # relative to sortmerna root dir
  build: build/3rdparty/rocksdb  # cmake build directory
  preset: cmake/presets/CMakePresets_rocksdb.json  # copy to RocksDB source dir -> 3rdparty/rocksdb/ (default)
  dist: {{rocksdb_dist}} # '--rocksdb-dist' or default 'build/3rdparty/rocksdb/dist' (setup.py)
  is_git: true
  is_checkout: true

indexed_bzip2:
  note: header-only rapidgzip library for seekable parallel gzip decompression
  url: https://github.com/mxmlnkn/indexed_bzip2.git
  commit: master
  shallow: true
  src: 3rdparty/indexed_bzip2 # relative to sortmerna
  dist: {{indexed_bzip2_dist}} # '--indexed-bzip2-dist' or default '3rdparty/indexed_bzip2' (setup.py)

bbhash:
  note: header-only minimal perfect hash function (BBHash/BooPHF) - replaces cmph
  url: https://github.com/rizkg/BBHash.git
  commit: master
  shallow: true
  src: 3rdparty/bbhash # relative to sortmerna
  dist: {{bbhash_dist}} # '--bbhash-dist' or default '3rdparty/bbhash' (setup.py)

parasail:
  note: SIMD-accelerated pairwise sequence alignment library (replaces SSW)
  url: https://github.com/jeffdaily/parasail.git
  commit: master
  shallow: true
  src: 3rdparty/parasail
  build: build/3rdparty/parasail
  dist: {{parasail_dist}} # '--parasail-dist' or default 'build/3rdparty/parasail/dist' (setup.py)
