{
    "version": 6,
    "cmakeMinimumRequired": {
      "major": 3,
      "minor": 21,
      "patch": 0
    },
    "configurePresets": [
        {
            "name": "common",
            "generator": "Ninja Multi-Config",
            "cacheVariables": {
                "ROCKSDB_USE_STATIC_LIBS": true,
                "ZLIB_USE_STATIC_LIBS": true,
                "WITH_TESTS": true,
                "ZLIB_ROOT": "${sourceDir}/build/3rdparty/zlib/dist",
                "ROCKSDB_DIST": "${sourceDir}/build/3rdparty/rocksdb/dist",
                "PARASAIL_DIST": "${sourceDir}/build/3rdparty/parasail/dist",
                "INDEXED_BZIP2_HOME": "${sourceDir}/3rdparty/indexed_bzip2/src",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/dist"
            }
        },
        {
            "name": "common2",
            "generator": "Ninja Multi-Config",
            "cacheVariables": {
                "ROCKSDB_USE_STATIC_LIBS": true,
                "ZLIB_USE_STATIC_LIBS": true,
                "WITH_TESTS": true,
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/dist"
            }
        },
        {
            "name": "LIN_release",
            "inherits": "common",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "LIN_debug",
            "inherits": "common",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "LIN_release",
            "configuration": "Release",
            "configurePreset": "LIN_release"
        },
        {
            "name": "LIN_debug",
            "configuration": "Debug",
            "configurePreset": "LIN_debug"
        }
    ]
}
